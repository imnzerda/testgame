{
  "name": "merge-around-the-world",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @maw/web",
    "build": "npm run build -w @maw/web",
    "preview": "npm run preview -w @maw/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/engine && tsc -p packages/content && npm run check -w @maw/web",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
